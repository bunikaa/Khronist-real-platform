{
  "name": "khronist",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @khronist/api db:generate",
    "db:migrate": "pnpm --filter @khronist/api db:migrate"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}
