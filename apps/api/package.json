{
  "name": "@khronist/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@khronist/contracts": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "p-queue": "^10.0.0",
    "postgres": "^4.0.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@khronist/config": "workspace:*",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.0.5"
  }
}
